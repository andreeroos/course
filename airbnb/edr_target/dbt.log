  abs(coalesce(a.expression, 0) - coalesce(b.expression, 0)) as expression_difference,\\n            abs(coalesce(a.expression, 0) - coalesce(b.expression, 0))/\\n                nullif(a.expression * 1.0, 0) as expression_difference_percent\\n        from\\n        \\n            a cross join b\\n        \\n    )\\n    -- DEBUG:\\n    -- select * from final\\n    select\\n        *\\n    from final\\n    where\\n        \\n        expression_difference > 0.0\\n        \\n\", \"other\": null, \"test_name\": \"expect_table_row_count_to_equal_other_table\", \"test_params\": \"{\\\"compare_model\\\": \\\"{{ source('airbnb', 'listings') }}\\\", \\\"model\\\": \\\"{{ get_where_subquery(ref('dim_listings_hosts')) }}\\\"}\", \"severity\": \"ERROR\", \"status\": \"pass\", \"execution_time\": 1.0613088607788086, \"days_diff\": 0, \"invocations_rank_index\": 1, \"failures\": 0, \"result_rows\": null, \"sample_data\": null}, {\"id\": \"1b7cd38c-82a5-405d-a22d-c5f1b38108fa.test.airbnb.dbt_expectations_source_expect_column_values_to_match_regex_airbnb_listings_price___0_9_0_9_.2276a79dfc\", \"invocation_id\": \"1b7cd38c-82a5-405d-a22d-c5f1b38108fa\", \"test_execution_id\": \"1b7cd38c-82a5-405d-a22d-c5f1b38108fa.test.airbnb.dbt_expectations_source_expect_column_values_to_match_regex_airbnb_listings_price___0_9_0_9_.2276a79dfc\", \"model_unique_id\": \"source.airbnb.airbnb.listings\", \"test_unique_id\": \"test.airbnb.dbt_expectations_source_expect_column_values_to_match_regex_airbnb_listings_price___0_9_0_9_.2276a79dfc\", \"elementary_unique_id\": \"test.airbnb.dbt_expectations_source_expect_column_values_to_match_regex_airbnb_listings_price___0_9_0_9_.2276a79dfc.price.expectation\", \"detected_at\": \"2026-03-25T10:19:58\", \"database_name\": \"AIRBNB\", \"schema_name\": \"raw\", \"table_name\": \"raw_listings\", \"column_name\": \"price\", \"test_type\": \"dbt_test\", \"test_sub_type\": \"expectation\", \"test_results_description\": null, \"test_description\": \"Expect column e