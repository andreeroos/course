_.0f1817fd7f\", \"elementary_unique_id\": \"test.airbnb.dbt_expectations_expect_table_row_count_to_equal_other_table_dim_listings_hosts__source_airbnb_listings_.0f1817fd7f.None.expectation\", \"detected_at\": \"2026-03-25T10:19:58\", \"database_name\": \"AIRBNB\", \"schema_name\": \"DEV\", \"table_name\": \"dim_listings_hosts\", \"column_name\": null, \"test_type\": \"dbt_test\", \"test_sub_type\": \"expectation\", \"test_results_description\": null, \"test_description\": \"Expect the number of rows in a model match another model.\", \"original_path\": \"models\\\\schema.yml\", \"package_name\": \"airbnb\", \"owners\": \"[]\", \"model_owner\": \"[]\", \"tags\": \"[]\", \"test_tags\": \"[]\", \"model_tags\": \"[]\", \"meta\": \"{}\", \"model_meta\": \"{}\", \"test_results_query\": \"\\n    with a as (\\n        \\n    select\\n        \\n        count(*) as expression\\n    from\\n        AIRBNB.DEV.dim_listings_hosts\\n    \\n\\n    ),\\n    b as (\\n        \\n    select\\n        \\n        count(*) * 1 as expression\\n    from\\n        AIRBNB.raw.raw_listings\\n    \\n\\n    ),\\n    final as (\\n\\n        select\\n            \\n            a.expression,\\n            b.expression as compare_expression,\\n            abs(coalesce(a.expression, 0) - coalesce(b.expression, 0)) as expression_difference,\\n            abs(coalesce(a.expression, 0) - coalesce(b.expression, 0))/\\n                nullif(a.expression * 1.0, 0) as expression_difference_percent\\n        from\\n        \\n            a cross join b\\n        \\n    )\\n    -- DEBUG:\\n    -- select * from final\\n    select\\n        *\\n    from final\\n    where\\n        \\n        expression_difference > 0.0\\n        \\n\", \"other\": null, \"test_name\": \"expect_table_row_count_to_equal_other_table\", \"test_params\": \"{\\\"compare_model\\\": \\\"{{ source('airbnb', 'listings') }}\\\", \\\"model\\\": \\\"{{ get_where_subquery(ref('dim_listings_hosts')) }}\\\"}\", \"severity\": \"ERROR\", \"stat