osts\", \"column_name\": null, \"test_type\": \"dbt_test\", \"test_sub_type\": \"expectation\", \"test_results_description\": null, \"test_description\": \"Expect the number of rows in a model match another model.\", \"original_path\": \"models\\\\schema.yml\", \"package_name\": \"airbnb\", \"owners\": \"[]\", \"model_owner\": \"[]\", \"tags\": \"[]\", \"test_tags\": \"[]\", \"model_tags\": \"[]\", \"meta\": \"{}\", \"model_meta\": \"{}\", \"test_results_query\": \"\\n    with a as (\\n        \\n    select\\n        \\n        count(*) as expression\\n    from\\n        AIRBNB.DEV.dim_listings_hosts\\n    \\n\\n    ),\\n    b as (\\n        \\n    select\\n        \\n        count(*) * 1 as expression\\n    from\\n        AIRBNB.raw.raw_listings\\n    \\n\\n    ),\\n    final as (\\n\\n        select\\n            \\n            a.expression,\\n            b.expression as compare_expression,\\n            abs(coalesce(a.expression, 0) - coalesce(b.expression, 0)) as expression_difference,\\n            abs(coalesce(a.expression, 0) - coalesce(b.expression, 0))/\\n                nullif(a.expression * 1.0, 0) as expression_difference_percent\\n        from\\n        \\n            a cross join b\\n        \\n    )\\n    -- DEBUG:\\n    -- select * from final\\n    select\\n        *\\n    from final\\n    where\\n        \\n        expression_difference > 0.0\\n        \\n\", \"other\": null, \"test_name\": \"expect_table_row_count_to_equal_other_table\", \"test_params\": \"{\\\"compare_model\\\": \\\"{{ source('airbnb', 'listings') }}\\\", \\\"model\\\": \\\"{{ get_where_subquery(ref('dim_listings_hosts')) }}\\\"}\", \"severity\": \"ERROR\", \"status\": \"pass\", \"execution_time\": 0.7494950294494629, \"days_diff\": 0, \"invocations_rank_index\": 1, \"failures\": 0, \"result_rows\": null, \"sample_data\": null}, {\"id\": \"20e39cd3-eb4c-4ab7-8091-d5939dfee99a.test.airbnb.dbt_expectations_source_expect_column_values_to_match_regex_airbnb_listings_price___0_9_0_9_.2