"schema\": \"DEV\", \"status\": \"success\", \"execution_time\": 1.4, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": null, \"generated_at\": \"2026-03-18 08:12:22\"}, {\"unique_id\": \"model.airbnb.fct_reviews\", \"invocation_id\": \"4826f50e-079d-4aa3-96b5-b8a75efcdedf\", \"name\": \"fct_reviews\", \"schema\": \"DEV\", \"status\": \"success\", \"execution_time\": 2, \"full_refresh\": false, \"materialization\": \"incremental\", \"compiled_code\": \"\\nwith  __dbt__cte__src_reviews as (\\nwith raw_reviews as (\\nselect * \\nfrom AIRBNB.raw.raw_reviews\\n\\n)\\nSELECT\\n    LISTING_ID, \\n    DATE as REVIEW_DATE, \\n    REVIEWER_NAME, \\n    COMMENTS AS REVIEW_TEXT, \\n    SENTIMENT AS REVIEW_SENTIMENT\\nFROM\\n    raw_reviews\\n), src_reviews as (\\n\\nselect * from __dbt__cte__src_reviews\\n)\\nselect * from src_reviews\\nwhere review_text is not null\\n\\nAND review_date> (select max(review_date) from AIRBNB.DEV.fct_reviews)\\n\\n\", \"generated_at\": \"2026-03-27 07:27:28\"}, {\"unique_id\": \"model.airbnb.mart_fullmoon_reviews\", \"invocation_id\": \"4826f50e-079d-4aa3-96b5-b8a75efcdedf\", \"name\": \"mart_fullmoon_reviews\", \"schema\": \"DEV\", \"status\": \"success\", \"execution_time\": 2.1, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"\\n\\nWITH fct_reviews AS (\\n    SELECT * FROM AIRBNB.DEV.fct_reviews\\n),\\nfull_moon_dates AS (\\n    SELECT * FROM AIRBNB.DEV.seed_full_moon_dates\\n)\\n\\nSELECT\\n  r.*,\\n  CASE\\n    WHEN fm.full_moon_date IS NULL THEN 'not full moon'\\n    ELSE 'full moon'\\n  END AS is_full_moon\\nFROM\\n  fct_reviews\\n  r\\n  LEFT JOIN full_moon_dates\\n  fm\\n  ON (TO_DATE(r.review_date) = DATEADD(DAY, 1, fm.full_moon_date))\", \"generated_at\": \"2026-03-27 07:27:28\"}, {\"unique_id\": \"model.airbnb.dim_listings_cleansed\", \"invocation_id\": \"4826f50e-079d-4aa3-96b5-b8a75efcdedf\", \"name\": \"dim_listings_cleansed\", \"schema\": \"DEV\", \"status\": \"success\", \"